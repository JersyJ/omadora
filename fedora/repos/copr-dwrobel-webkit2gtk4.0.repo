# WebKitGTK 4.0 (libsoup 2) for Fedora 43 and later, which dropped it. Intune
# Portal and Microsoft's identity broker link libwebkit2gtk-4.0. Preferred over
# the company guide's workaround of taking it from end-of-life Fedora 42.
[copr:copr.fedorainfracloud.org:dwrobel:webkit2gtk4.0]
name=Copr repo for webkit2gtk4.0 owned by dwrobel
baseurl=https://download.copr.fedorainfracloud.org/results/dwrobel/webkit2gtk4.0/fedora-$releasever-$basearch/
type=rpm-md
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/dwrobel/webkit2gtk4.0/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
includepkgs=webkit2gtk4.0 javascriptcoregtk4.0

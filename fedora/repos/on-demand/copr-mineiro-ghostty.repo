[copr:copr.fedorainfracloud.org:mineiro:ghostty]
name=Copr repo for ghostty owned by mineiro
baseurl=https://download.copr.fedorainfracloud.org/results/mineiro/ghostty/fedora-$releasever-$basearch/
type=rpm-md
gpgcheck=1

# Single-package COPRs with Fedora 45 builds.
[copr:copr.fedorainfracloud.org:boobaa:lazygit]
name=Copr repo for lazygit owned by boobaa
baseurl=https://download.copr.fedorainfracloud.org/results/boobaa/lazygit/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/omadora/copr-boobaa-lazygit.asc
repo_gpgcheck=0
enabled=1
enabled_metadata=1
includepkgs=lazygit


#!/bin/sh
# Import the local signing keys that the enabled repositories name: Omadora's
# (/etc/pki/rpm-gpg/omadora), Fedora's and RPM Fusion's. dnf asks before it
# trusts a repository's key, and dnf5-automatic, which installs the daily
# security updates, cannot answer, so it would cancel every run until someone
# ran dnf by hand. Runs before every dnf5-automatic run (a drop-in from
# omadora-repos) and once at the end of the install (the kickstart); it cannot
# run from a package scriptlet, where rpm holds its database lock.
releasever=$(rpm -E %fedora)
basearch=$(uname -m)
sed -n 's/^gpgkey[[:space:]]*=[[:space:]]*//p' /etc/yum.repos.d/*.repo | tr ' ,' '\n\n' |
  sed -n 's|^file://||p' | sed "s/\$releasever/$releasever/g; s/\$basearch/$basearch/g" | sort -u |
  while read -r key; do
    if [ -f "$key" ]; then
      rpmkeys --import "$key" || echo "omadora: could not import $key" >&2
    fi
  done
exit 0

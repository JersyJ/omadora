# The Hyprland stack. Versions are held by versionlock.toml.
[copr:copr.fedorainfracloud.org:nett00n:hyprland]
name=Copr repo for hyprland owned by nett00n
baseurl=https://download.copr.fedorainfracloud.org/results/nett00n/hyprland/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/nett00n/hyprland/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
includepkgs=hyprland hyprland-guiutils hyprpicker hyprsunset quickshell uwsm xdg-desktop-portal-hyprland aquamarine hyprcursor hyprgraphics hyprlang hyprtoolkit hyprutils hyprwire hyprland-qt-support hyprqt6engine glaze cpptrace libdwarf-code

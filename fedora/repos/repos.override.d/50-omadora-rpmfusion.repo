# Limits RPM Fusion to the packages Omadora takes from it. RPM Fusion's own
# release packages own its .repo files, so the limit is a dnf5 override,
# installed in /etc/dnf/repos.override.d/.
# Free: full ffmpeg (H.264/HEVC encode) and its codec libraries.
# Free, on demand: v4l2loopback. Nonfree: Intel's full media driver and
# fdk-aac; Steam on demand. No NVIDIA: the company ZBooks have none.

[rpmfusion-free]
includepkgs=rpmfusion-free-* ffmpeg ffmpeg-libs libavdevice vvenc-libs x264-libs x265-libs v4l2loopback akmod-v4l2loopback kmod-v4l2loopback*

[rpmfusion-free-updates]
includepkgs=rpmfusion-free-* ffmpeg ffmpeg-libs libavdevice vvenc-libs x264-libs x265-libs v4l2loopback akmod-v4l2loopback kmod-v4l2loopback*

[rpmfusion-free-updates-testing]
includepkgs=rpmfusion-free-* ffmpeg ffmpeg-libs libavdevice vvenc-libs x264-libs x265-libs v4l2loopback akmod-v4l2loopback kmod-v4l2loopback*

[rpmfusion-nonfree]
includepkgs=rpmfusion-nonfree-* intel-media-driver fdk-aac steam

[rpmfusion-nonfree-updates]
includepkgs=rpmfusion-nonfree-* intel-media-driver fdk-aac steam

[rpmfusion-nonfree-updates-testing]
includepkgs=rpmfusion-nonfree-* intel-media-driver fdk-aac steam

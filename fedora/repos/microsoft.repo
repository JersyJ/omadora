# Microsoft's RHEL 10 repository: Intune Portal with its identity broker, and
# Defender for Endpoint, which company compliance requires (fedora/docs/INTUNE.md).
# The RHEL 10 builds use WebKitGTK 6.0 and libsoup 3 from Fedora; the RHEL 9
# ones need the WebKitGTK 4.0 API, which upstream dropped in 2.52.
[packages-microsoft-com-prod]
name=Microsoft RHEL 10 production
baseurl=https://packages.microsoft.com/rhel/10/prod/
enabled=1
gpgcheck=1
# Package signatures are checked, metadata signatures are not, as for Fedora's
# own repositories: dnf keeps metadata keys in a keyring only its interactive
# prompt fills, so the unattended daily update could never read this repository.
repo_gpgcheck=0
gpgkey=file:///etc/pki/rpm-gpg/omadora/microsoft-rhel10.asc
includepkgs=intune-portal microsoft-identity-broker microsoft-identity-diagnostics mdatp

#!/bin/bash

# omarchy:summary=Remove all the named packages from the system if they're installed (otherwise ignore).
# omarchy:args=<packages...>
# omarchy:requires-sudo=true

# Fedora fork: removes the packages Omadora's package map gives for the Arch
# names, with dnf (which also drops unneeded dependencies), flatpak or mise.
source "${OMARCHY_PATH:-/usr/share/omarchy}/fedora/pkg.sh"

omadora_pkg_drop "$@"

#!/bin/bash

# omarchy:summary=Ensure the package signing keys are in place
# omarchy:requires-sudo=true

# Fedora fork: Fedora's keys ship in fedora-gpg-keys and update with the
# system; every other repository names its key in its .repo file (gpgkey=),
# and dnf imports it on first use. There is no keyring to refresh.
exit 0

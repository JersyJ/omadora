#!/bin/bash

# omarchy:summary=Check the update log for known failure conditions

update_log="/tmp/omarchy-update.log"

# Fedora fork: kernels are installed by kernel-install, which runs dracut for
# the initramfs and writes a boot loader entry. Check the result directly
# instead of reading pacman's mkinitcpio messages: every installed kernel needs
# a non-empty initramfs and a boot entry, or booting it fails.
problems=()
while read -r version; do
  [[ -n $version ]] || continue
  [[ -s /boot/vmlinuz-$version ]] || problems+=("/boot/vmlinuz-$version is missing")
  [[ -s /boot/initramfs-$version.img ]] || problems+=("/boot/initramfs-$version.img is missing")
  compgen -G "/boot/loader/entries/*-$version.conf" >/dev/null || problems+=("no boot entry for $version")
done < <(rpm -q --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}\n' kernel-core 2>/dev/null)

if (( ${#problems[@]} )) || grep -qE 'dracut(\[[0-9]+\])?: .*(ERROR|FAILED)|kernel-install: .*fail' "$update_log" 2>/dev/null; then
  echo -e '\e[31mError: Initramfs generation may have failed. Review logs before restart.\e[0m'
  printf '  %s\n' "${problems[@]}"
  echo
fi

#!/bin/bash

# omarchy:summary=Returns true if all of the named packages are installed on the system (or false if any of them are missing).
# omarchy:args=<packages...>

# Fedora fork: checks the packages Omadora's package map gives for the Arch names.
source "${OMARCHY_PATH:-/usr/share/omarchy}/fedora/pkg.sh"

omadora_pkg_present "$@"

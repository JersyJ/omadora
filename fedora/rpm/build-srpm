#!/bin/bash

# Build the source RPM for one recipe, fedora/rpm/<name>/<name>.spec.
#
# Downloads the spec's remote sources, verifies them against the recipe's
# sources.sha256, vendors Rust crates or Go modules when the recipe has a
# cargo-vendor or go-vendor marker (so the binary build needs no network), and
# packs the SRPM. COPR runs this through .copr/Makefile (the make_srpm
# method); it also works on any Fedora machine or container.
#
# Recipes with an assemble marker (omarchy, omarchy-settings, omadora-repos)
# are built from this repository instead of a download: build-srpm runs
# fedora/build/assemble, packs the result as Source0, and fills the spec's
# @VERSION@ and @RELEASE@ from fedora/upstream.lock and the fork's HEAD.
#
# Usage: fedora/rpm/build-srpm <spec> <outdir>
#
# Adapted from kamm3r/omadora-pkg's .copr/Makefile (MIT).

set -euo pipefail

die() {
  echo "error: $*" >&2
  exit 1
}

(( $# == 2 )) || die "usage: build-srpm <spec> <outdir>"

spec=$(realpath "$1")
outdir=$(realpath -m "$2")
recipe=$(dirname "$spec")
name=$(basename "$spec" .spec)

[[ $(basename "$recipe") == "$name" ]] || die "$spec must live in a directory named $name"
[[ -f $recipe/sources.sha256 ]] || die "$recipe/sources.sha256 is missing; every remote source must be pinned"

missing=()
for tool in spectool rpmbuild rpmspec sha256sum git patch; do
  command -v "$tool" >/dev/null || missing+=("$tool")
done
if (( ${#missing[@]} > 0 )); then
  dnf -y install rpmdevtools rpm-build git-core patch
fi

mkdir -p "$outdir"

# The spec plus any local files it ships (patches, units), but not the
# recipe's own metadata.
find "$recipe" -maxdepth 1 -type f \
  ! -name sources.sha256 ! -name cargo-vendor ! -name go-vendor ! -name assemble \
  -exec cp -t "$outdir" {} +

# Built from this repository: the assembled Fedora tree is Source0.
if [[ -f $recipe/assemble ]]; then
  # shellcheck source=../lib/common.sh
  source "$(dirname "$(realpath "$0")")/../lib/common.sh"
  load_lock
  git config --global --add safe.directory "$FEDORA_ROOT" 2>/dev/null || :
  rpm_version=$(omadora_version)
  rpm_release=$(omadora_release)
  sed -i -e "s/@VERSION@/$rpm_version/g" -e "s/@RELEASE@/$rpm_release/g" "$outdir/$name.spec"
  tree="$outdir/assemble/omarchy-$rpm_version"
  "$FEDORA_DIR/build/assemble" --out "$tree"
  tar -C "$outdir/assemble" -czf "$outdir/omarchy-$rpm_version.tar.gz" "omarchy-$rpm_version"
  rm -rf "$outdir/assemble"
fi

spectool --get-files --directory "$outdir" "$outdir/$name.spec"
if [[ -s $recipe/sources.sha256 ]]; then
  (cd "$outdir" && sha256sum --check --quiet "$recipe/sources.sha256")
fi

version=$(rpmspec --query --srpm --queryformat '%{VERSION}' "$outdir/$name.spec")

# Rust and Go: vendor the locked dependency graph into
# <name>-vendor-<version>.tar.gz next to the source archive. A marker may name
# the archive's top directory, with %version substituted; it defaults to
# <name>-<version>.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

source_root() {
  local marker=$1 root="$name-$version"

  if [[ -s $marker ]]; then
    root=$(sed "s/%version/$version/g" "$marker")
  fi
  tar -xzf "$outdir/$name-$version.tar.gz" -C "$work"
  [[ -d $work/$root ]] || die "no $root in $name-$version.tar.gz; name the archive's top directory in $marker"
  echo "$work/$root"
}

if [[ -f $recipe/cargo-vendor ]]; then
  command -v cargo >/dev/null || dnf -y install cargo
  root=$(source_root "$recipe/cargo-vendor")
  [[ -f $root/Cargo.lock ]] || die "no Cargo.lock in $root"
  (
    cd "$root"
    mkdir -p .cargo
    cargo vendor --locked --versioned-dirs cargo-vendor >.cargo/config.toml
    tar -czf "$outdir/$name-vendor-$version.tar.gz" cargo-vendor .cargo
  )
fi

if [[ -f $recipe/go-vendor ]]; then
  command -v go >/dev/null || dnf -y install golang
  root=$(source_root "$recipe/go-vendor")
  [[ -f $root/go.sum ]] || die "no go.sum in $root"
  (
    cd "$root"
    GOTOOLCHAIN=auto go mod vendor
    tar -czf "$outdir/$name-vendor-$version.tar.gz" vendor
  )
fi

rpmbuild -bs \
  --define "_sourcedir $outdir" \
  --define "_srcrpmdir $outdir" \
  "$outdir/$name.spec"

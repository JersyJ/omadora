#!/bin/bash

# Report the porting backlog: files in the assembled Fedora tree that still
# reference Arch-only tooling after overrides and patches are applied. Only
# code counts: comment lines and binary files (theme images, videos) do not.
# Migrations are tracked separately by fedora/bin/migrations-status.
#
# Usage: fedora/bin/port-status [--list]

set -euo pipefail
source "$(dirname "$(realpath "$0")")/../lib/common.sh"

list=0
if [[ ${1:-} == "--list" ]]; then
  list=1
fi

cd "$FEDORA_ROOT"
out="$FEDORA_DIR/.build/port-status"
"$FEDORA_DIR/build/assemble" --out "$out" >/dev/null

declare -A patterns=(
  [pacman]='\bpacman\b|/etc/pacman|pacman-key|\bpaccache\b|\bexpac\b'
  [aur]='\byay\b|\bmakepkg\b|aur\.archlinux'
  [boot]='mkinitcpio|limine|libalpm'
  [ufw]='\bufw\b'
)

# Files with a matching line that is not a comment (# or //).
matching_files() {
  grep -rInE "$1" "$out" --exclude-dir=migrations --exclude-dir=fedora 2>/dev/null |
    awk -F: '{ line = $0; sub(/^[^:]*:[0-9]+:/, "", line) } line !~ /^[[:space:]]*(#|\/\/)/ { print $1 }' |
    sed "s|^$out/||" | sort -u
}

for category in pacman aur boot ufw; do
  mapfile -t files < <(matching_files "${patterns[$category]}")
  printf '  %-8s %4d files\n' "$category" "${#files[@]}"
  if (( list )) && (( ${#files[@]} > 0 )); then
    printf '      %s\n' "${files[@]}"
  fi
done

mapfile -t all < <(matching_files "${patterns[pacman]}|${patterns[aur]}|${patterns[boot]}|${patterns[ufw]}")
echo "  ----"
printf '  %-8s %4d files still reference Arch-only tooling\n' "total" "${#all[@]}"

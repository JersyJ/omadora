#!/bin/bash

# Print an Anaconda kickstart that installs Omadora on Fedora from the network
# installer (Fedora Everything netinst).
#
# Repositories come from fedora/repos with the same includepkgs limits the
# installed system keeps (through the omadora-repos package); the package set
# is upstream's base list translated through fedora/packages/map.tsv. The disk
# is wiped: btrfs on LUKS2 (Fedora's layout), /boot and the EFI partition
# outside it so Secure Boot keeps working. %post runs Omarchy's system setup as
# root and its user setup as the new user.
#
# Usage: fedora/bin/kickstart --user NAME [options] >omadora.ks
#   --user NAME              the user to create (required)
#   --password-hash HASH     crypt(3) hash of the user's password, e.g. from
#                            `openssl passwd -6`; without it Anaconda asks
#   --luks-passphrase TEXT   disk passphrase; without it Anaconda asks
#   --timezone ZONE          default Europe/Prague
#   --keyboard LAYOUT        default us
#   --lang LOCALE            default en_US.UTF-8
#   --disk DEVICE            install to this disk only, e.g. vda or nvme0n1
#   --reboot                 reboot when done instead of waiting
#   --overlay URL            test only: before setup, lay this assembled tree
#                            (a .tar.gz from fedora/build/assemble) over the
#                            installed omarchy files, to test local changes
#                            without rebuilding the packages
#   --test                   for fedora/tests/vm-install.sh only: no disk
#                            encryption, SDDM logs the user straight in, and a
#                            self-test reports to the serial console
#   --test-password-login    with --test: log in as on a laptop instead, with
#                            the disk encrypted (needs --luks-passphrase) and
#                            the password typed at SDDM; the LUKS prompt also
#                            goes to the serial console, which reports when the
#                            greeter and the user's session are up

set -euo pipefail
source "$(dirname "$(realpath "$0")")/../lib/common.sh"

user="" password_hash="" luks_passphrase="" timezone=Europe/Prague keyboard=us lang=en_US.UTF-8 disk="" reboot=0 test=0 password_login=0 overlay=""
while (( $# > 0 )); do
  case $1 in
    --user) user=$2; shift 2 ;;
    --password-hash) password_hash=$2; shift 2 ;;
    --luks-passphrase) luks_passphrase=$2; shift 2 ;;
    --timezone) timezone=$2; shift 2 ;;
    --keyboard) keyboard=$2; shift 2 ;;
    --lang) lang=$2; shift 2 ;;
    --disk) disk=$2; shift 2 ;;
    --reboot) reboot=1; shift ;;
    --test) test=1; shift ;;
    --test-password-login) password_login=1; shift ;;
    --overlay) overlay=$2; shift 2 ;;
    *) die "unknown option $1 (see the header of fedora/bin/kickstart)" ;;
  esac
done
[[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || die "--user must be a valid user name"
if (( password_login )); then
  (( test )) || die "--test-password-login is a --test mode"
  [[ -n $luks_passphrase ]] || die "--test-password-login needs --luks-passphrase"
fi
encrypted=$(( !test || password_login ))

cd "$FEDORA_ROOT"
load_lock
release=$FEDORA_RELEASE

# One `repo` line per section of fedora/repos/*.repo, with its includepkgs.
repo_lines() {
  awk -F= '
    function flush() {
      if (section == "") return
      gsub(/\$releasever/, release, baseurl)
      line = "repo --name=" name " --baseurl=" baseurl
      if (include != "") { gsub(/ +/, ",", include); line = line " --includepkgs=" include }
      print line
    }
    /^\[/ { flush(); section = substr($0, 2, length($0) - 2); name = section; gsub(/[^A-Za-z0-9_-]/, "-", name); baseurl = ""; include = ""; next }
    /^baseurl=/ { baseurl = substr($0, 9) }
    /^includepkgs=/ { include = substr($0, 13) }
    END { flush() }
  ' release="$release" fedora/repos/*.repo
}

# RPM Fusion, limited like fedora/repos/repos.override.d (free and nonfree,
# release and updates).
rpmfusion_lines() {
  local kind include

  for kind in free nonfree; do
    include=$(awk -v section="[rpmfusion-$kind]" '$0 == section { found = 1; next } found && /^includepkgs=/ { print substr($0, 13); exit }' \
      fedora/repos/repos.override.d/*.repo | tr ' ' ',')
    echo "repo --name=rpmfusion-$kind --mirrorlist=https://mirrors.rpmfusion.org/mirrorlist?repo=$kind-fedora-$release&arch=\$basearch --includepkgs=$include"
    # RPM Fusion opens a release's updates repository only when Fedora ships
    # it, and Anaconda fails on a repository that does not exist yet.
    updates="https://mirrors.rpmfusion.org/mirrorlist?repo=$kind-fedora-updates-released-$release&arch=x86_64"
    if curl -sf --max-time 30 "$updates" | grep -q '^http'; then
      echo "repo --name=rpmfusion-$kind-updates --mirrorlist=${updates%x86_64}\$basearch --includepkgs=$include"
    else
      echo "# rpmfusion-$kind-updates: not open yet for Fedora $release"
    fi
  done
}

# Fedora packages Omadora adds beyond upstream's lists (fedora/packages/extra.txt).
extra_lines() {
  sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' fedora/packages/extra.txt
}

# Fedora package names for upstream's base and x86_64-only lists.
package_lines() {
  local list

  for list in base x86_64-only; do
    sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "install/omarchy-$list.packages"
  done | sort -u | awk -F'\t' '
    NR == FNR { wanted[$1] = 1; next }
    !/^#/ && ($1 in wanted) && $3 !~ /^(drop|todo|flatpak|mise:)/ {
      n = split($2, names, " ")
      for (i = 1; i <= n; i++) print names[i]
    }' - fedora/packages/map.tsv | sort -u
}

cat <<EOF
# Omadora kickstart, generated by fedora/bin/kickstart from
# $(git rev-parse --short HEAD) (upstream $UPSTREAM_REF ${UPSTREAM_COMMIT:0:10}).
# Installs Fedora $release with Omarchy. WIPES THE TARGET DISK.

text
lang $lang
keyboard $keyboard
timezone $timezone --utc
network --bootproto=dhcp --activate
selinux --enforcing
firewall --enabled
# Fedora enables sshd; Omarchy leaves it off until omarchy-setup-security-sshd.
services --disabled=sshd
firstboot --disable
$( (( reboot )) && echo "reboot" || echo "# no reboot: inspect the install, then reboot by hand" )

url --mirrorlist=https://mirrors.fedoraproject.org/mirrorlist?repo=fedora-$release&arch=\$basearch
repo --name=updates --mirrorlist=https://mirrors.fedoraproject.org/mirrorlist?repo=updates-released-f$release&arch=\$basearch
$(rpmfusion_lines)
$(repo_lines)

# Disk: GPT, EFI + /boot outside the encrypted btrfs (GRUB and Secure Boot),
# root and home as btrfs subvolumes on LUKS2.
zerombr
$( [[ -n $disk ]] && echo "ignoredisk --only-use=$disk" )
clearpart --all --initlabel --disklabel=gpt
$(if (( encrypted )); then echo "autopart --type=btrfs --encrypted --luks-version=luks2${luks_passphrase:+ --passphrase=$luks_passphrase}"; else echo "autopart --type=btrfs"; fi)
bootloader --append="rhgb quiet$( (( password_login )) && echo " console=ttyS0,115200 console=tty0")"

rootpw --lock
user --name=$user --groups=wheel$( [[ -n $password_hash ]] && echo " --iscrypted --password=$password_hash" )

%packages
@core
$(extra_lines)
omadora-repos
omarchy-settings
omarchy
rpmfusion-free-release
rpmfusion-nonfree-release
$(package_lines)
%end

$( [[ -n $overlay ]] && cat <<OVERLAY
%post --interpreter=/bin/bash --log=/var/log/omadora-kickstart-overlay.log --erroronfail
# Test only: the local tree replaces the packaged omarchy files.
set -euo pipefail
mkdir -p /tmp/omadora-overlay
curl -sf "$overlay" | tar -xz -C /tmp/omadora-overlay
tree=\$(echo /tmp/omadora-overlay/omarchy-*)
install -m 0755 "\$tree"/bin/* /usr/bin/
cp -a "\$tree"/install "\$tree"/themes "\$tree"/migrations "\$tree"/shell "\$tree"/default "\$tree"/config /usr/share/omarchy/
install -m 0644 "\$tree"/fedora/pkg.sh /usr/share/omarchy/fedora/pkg.sh
install -m 0644 "\$tree"/fedora/packages/map.tsv /usr/share/omarchy/fedora/packages/map.tsv
ln -sfn chromium-browser /usr/bin/chromium
install -m 0644 "\$tree"/fedora/compat/chromium.desktop /usr/share/applications/chromium.desktop
echo "Overlaid \$(cat "\$tree"/version) from $overlay"
%end

OVERLAY
)
%post --interpreter=/bin/bash --log=/var/log/omadora-kickstart.log --erroronfail
set -euo pipefail
$( (( test )) && echo "exec > >(tee /dev/ttyS0) 2>&1  # test only: everything below also goes to the serial console" )
export OMARCHY_INSTALL_LOG_FILE=/var/log/omarchy-install.log
# Anaconda reports a failed %post only generically; put the reason in this log.
trap 'echo "Omadora setup failed; the last lines of \$OMARCHY_INSTALL_LOG_FILE:"; tail -n 60 "\$OMARCHY_INSTALL_LOG_FILE" 2>/dev/null' ERR

# Omarchy's system setup, as the ISO runs it in the target chroot.
omarchy-apply-system --install-user $user --first-install

# Omarchy's user setup, as the new user. The setup context is the one
# upstream's first-boot owner setup uses: Node.js comes from the network (the
# ISO context expects a tarball the ISO bundles), and the theme is applied
# without a display, as in the ISO.
# Root's XDG_RUNTIME_DIR must not leak in: the user's commands would put their
# locks in /run/user/0.
runuser -u $user -- env -u XDG_RUNTIME_DIR HOME=/home/$user USER=$user OMARCHY_INSTALL_LOG_FILE=\$OMARCHY_INSTALL_LOG_FILE \\
  OMARCHY_SETUP_CONTEXT=provision-owner omarchy-provision-user --first-install

# Omarchy's boot splash lives in the initramfs.
plymouth-set-default-theme omarchy
dracut --force --regenerate-all

systemctl set-default graphical.target

# SDDM's Omarchy theme has no user field: it logs in the last user. Record the
# new one, as upstream's first-boot owner setup does, or the first login fails.
mkdir -p /var/lib/sddm
printf '[Last]\nSession=omarchy.desktop\nUser=%s\n' $user >/var/lib/sddm/state.conf

# Files written above get their SELinux labels before the first boot.
restorecon -RF /etc /home /var/lib /var/log /usr/local
%end
EOF

if (( test )); then
  sed "s/@USER@/$user/g" <<'TEST'

# Test only (fedora/tests/vm-install.sh): a self-test that reports to the
# serial console.
%post --interpreter=/bin/bash --log=/var/log/omadora-kickstart-test.log --erroronfail
cat >/usr/local/sbin/omadora-selftest <<'SCRIPT'
#!/bin/bash
# --serial: report to the serial console (the boot-time service).
[[ ${1:-} == "--serial" ]] && exec >/dev/ttyS0 2>&1
echo "=== OMADORA SELFTEST BEGIN"
echo "--- system: $(systemctl is-system-running)"
echo "--- failed units:"
systemctl --failed --no-legend --plain
echo "--- failed user units (@USER@):"
systemctl --machine=@USER@@.host --user --failed --no-legend --plain 2>&1 | head -n 20
echo "--- sddm: $(systemctl is-active sddm)"
echo "--- sessions:"
loginctl list-sessions --no-legend
echo "--- processes:"
pgrep -a -f 'Hyprland|start-hyprland|quickshell|uwsm' | cut -c1-160
echo "--- selinux: $(getenforce)"
echo "--- AVC denials since boot: $(ausearch -m avc -ts boot 2>/dev/null | grep -c 'type=AVC')"
ausearch -m avc -ts boot 2>/dev/null | grep 'type=AVC' | head -n 20 | cut -c1-300
echo "--- omarchy install log (failures):"
grep -E 'Failed|Error' /var/log/omarchy-install.log | head -n 20
echo "--- keyrings (@USER@): $(ls /home/@USER@/.local/share/keyrings 2>/dev/null | tr '\n' ' ')"
echo "--- login keyring locked: $(busctl --machine=@USER@@.host --user get-property org.freedesktop.secrets /org/freedesktop/secrets/collection/login org.freedesktop.Secret.Collection Locked 2>&1)"
echo "--- gnome-keyring PAM messages:"
journalctl -b --no-pager -o short-monotonic | grep 'gkr-pam' | cut -c1-240
echo "--- packages:"
rpm -q omarchy omarchy-settings omadora-repos hyprland quickshell sddm kernel
echo "--- wayland sessions: $(ls /usr/share/wayland-sessions /usr/local/share/wayland-sessions 2>/dev/null | tr '\n' ' ')"
echo "--- sddm log:"
journalctl -b -u sddm --no-pager -o cat | tail -n 30 | cut -c1-240
echo "--- @USER@'s journal:"
journalctl -b _UID="$(id -u @USER@)" --no-pager -o short-monotonic | tail -n 40 | cut -c1-240
echo "--- errors in this boot's journal:"
journalctl -b -p err --no-pager -o short-monotonic | tail -n 40 | cut -c1-240
echo "=== OMADORA SELFTEST END"
SCRIPT
chmod 0755 /usr/local/sbin/omadora-selftest
TEST
  if (( password_login )); then
    sed "s/@USER@/$user/g" <<'TEST'

# Password login: tell the test on the serial console when SDDM's greeter is
# up (so it can type the password) and when the user's session started.
cat >/usr/local/sbin/omadora-test-watch <<'SCRIPT'
#!/bin/bash
# Opened per message: the serial getty hangs the line up when it starts, which
# cuts off a descriptor opened before it.
until pgrep -f sddm-greeter >/dev/null; do sleep 2; done
echo "=== OMADORA GREETER" >/dev/ttyS0
until loginctl list-sessions --no-legend | awk '$3 == "@USER@" && $4 == "seat0"' | grep -q .; do sleep 2; done
echo "=== OMADORA SESSION" >/dev/ttyS0
SCRIPT
chmod 0755 /usr/local/sbin/omadora-test-watch

cat >/etc/systemd/system/omadora-test-watch.service <<'UNIT'
[Unit]
Description=Omadora VM test: report the greeter and the login
After=sddm.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/omadora-test-watch

[Install]
WantedBy=graphical.target
UNIT
systemctl enable omadora-test-watch.service
restorecon -RF /etc/systemd/system /usr/local/sbin
%end
TEST
  else
    sed "s/@USER@/$user/g" <<'TEST'

# Autologin: log straight into the Omarchy session and report once the
# desktop had time to start.
cat >/etc/sddm.conf.d/90-omadora-test-autologin.conf <<'CONF'
[Autologin]
User=@USER@
Session=omarchy.desktop
CONF

cat >/etc/systemd/system/omadora-selftest.service <<'UNIT'
[Unit]
Description=Omadora VM self-test
After=graphical.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 120
ExecStart=/usr/local/sbin/omadora-selftest --serial

[Install]
WantedBy=graphical.target
UNIT
systemctl enable omadora-selftest.service
restorecon -RF /etc/sddm.conf.d /etc/systemd/system /usr/local/sbin
%end
TEST
  fi
fi
